# Copy this file to .env (scripts/setup.sh does it for you) and fill in the key.
# Never commit .env. Only scripts/extract.py reads DATALAB_API_KEY; the web app
# does not call any model or API itself.

# Required for scripts/extract.py. Get a key from https://www.datalab.to
DATALAB_API_KEY=

# Everything below is optional — the defaults shown are what the server uses when
# a variable is unset.

# Where the queue keeps its data and its folders.
QUEUE_DB_FILE=.data/forms.db
# Scans dropped here for scripts/extract.py to read. The server only creates it.
QUEUE_INCOMING_DIR=files/incoming
# The working folder. A document is a <name>.json extraction and the <name>.pdf it
# was read from; the pair waits here until someone approves it.
QUEUE_PROCESSED_DIR=files/processing
QUEUE_APPROVED_DIR=files/approved
QUEUE_FAILED_DIR=files/failed

# Set to false to stop the folders being watched.
QUEUE_WATCH=true
QUEUE_POLL_MS=3000

# Reviewers who can pick their name in the console. Names must be unique.
# Read on each request; restart the server after changing it.
REVIEWERS=Asha Rao,Ben Lee,Chen Wei
