# Everything here is optional — the defaults shown are what the server uses when
# a variable is unset. Nothing in this file is a credential: the app only serves
# the console and the queue, and calls no model or inference endpoint of its own.

# Where the queue keeps its data and its folders.
QUEUE_DB_FILE=.data/forms.db
# Scans dropped here for scripts/extract.py to read. The server only creates it.
QUEUE_INCOMING_DIR=files/incoming
# The working folder. A document is a <name>.json extraction and the <name>.pdf it
# was read from; the pair waits here until someone approves it.
QUEUE_PROCESSED_DIR=files/processing
QUEUE_APPROVED_DIR=files/approved
QUEUE_FAILED_DIR=files/failed

# Set to false to stop the folders being watched.
QUEUE_WATCH=true
QUEUE_POLL_MS=3000
